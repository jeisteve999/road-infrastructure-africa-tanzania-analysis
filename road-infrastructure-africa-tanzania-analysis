      "source": [
        "import pandas as pd\n",
        "\n",
        "tanzania_data = pd.read_excel('/content/Tanzania.xlsx')\n",
        "\n",
        "tanzania_data"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "tanzania_data[\"Rd_length\"] = tanzania_data[\"Rd_length\"].astype(str).str.replace(\",\", \".\").astype(float)"
      ],
      "metadata": {
        "id": "K1t4OeCLjw2d"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "tanzania_data[\"Rd_length_km\"] = tanzania_data[\"Rd_length\"] /1000"
      ],
      "metadata": {
        "id": "9WjQhw2qkOLd"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "total_km = tanzania_data[\"Rd_length_km\"].sum()\n",
        "\n",
        "paved_km = tanzania_data[tanzania_data[\"Surface\"]== \"paved\"][\"Rd_length_km\"].sum()\n",
        "unpaved_km = tanzania_data[tanzania_data[\"Surface\"]== \"unpaved\"][\"Rd_length_km\"].sum()\n",
        "\n",
        "pct_paved = (paved_km/ total_km)*100\n",
        "pct_unpaved = (unpaved_km/ total_km)*100\n",
        "\n",
        "print(f\"Total km: {total_km: .2f}\")\n",
        "print(f\"Paved km: {paved_km: .2f} ({pct_paved:.2f}%)\")\n",
        "print(f\"unpaved km: {unpaved_km: .2f} ({pct_unpaved:.2f}%)\")"
      ],
